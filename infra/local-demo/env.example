# ТОЛЬКО локальный стенд. Секреты задавайте в .local/demo.env, не в Git.
N8N_ENCRYPTION_KEY=replace_with_random_64_character_hex_string
LOCAL_ESPO_API_KEY=replace_with_local_espocrm_api_key
LOCAL_ESPO_OWNER=replace_with_espocrm_api_user_id
CRM_DB_PASSWORD=replace_with_random_password
CRM_ROOT_PASSWORD=replace_with_another_random_password
CRM_ADMIN_PASSWORD=replace_with_another_random_password
# Используются только в CI для проверки Compose; настоящие значения создаёт telegram_setup.py.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id
# Заглушки только для проверки конфигурации: реальные параметры Bitrix24 хранятся локально.
BITRIX_WEBHOOK_URL=https://example.invalid/rest/1/exampletoken/
BITRIX_CONTACT_FIELD=UF_CRM_CONTACT_KEY
BITRIX_DEAL_FIELD=UF_CRM_DEAL_KEY
BITRIX_INSTALLATION_ID=example_installation
BITRIX_UNPROCESSED_STAGE=NEW
